        // -------------------------------------------------------------
        // Scroll-Responsive Moody Fluid Waves (Deep Navy & Burnt Rust)
        // -------------------------------------------------------------
        const canvas = document.getElementById('bgCanvas');
        const ctx = canvas.getContext('2d');

        let width, height;
        let time = 0;
        let scrollProgress = 0;

        function updateScrollProgress() {
            const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
            scrollProgress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
        }

        window.addEventListener('scroll', updateScrollProgress, { passive: true });

        function resizeCanvas() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            updateScrollProgress();
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function animateBg() {
            ctx.clearRect(0, 0, width, height);

            // 1. Rich Deep Navy Base Gradient
            const baseGrad = ctx.createLinearGradient(0, 0, width, height);
            baseGrad.addColorStop(0, '#060a17');
            baseGrad.addColorStop(0.5, '#0a1128');
            baseGrad.addColorStop(1, '#040711');
            ctx.fillStyle = baseGrad;
            ctx.fillRect(0, 0, width, height);

            time += 0.003;

            // Dynamic scroll shift for evolving pattern down the page
            const scrollShift = scrollProgress * height * 0.95;

            // 2. High-Opacity Vibrant Fluid Orbs & Wave Nodes
            const blobs = [
                // Deep Electric Navy Blue Orb (Top Left)
                {
                    x: width * 0.2 + Math.sin(time * 0.8) * 160,
                    y: (height * 0.2 - scrollShift * 0.5 + Math.cos(time * 0.6) * 110) % (height * 1.5),
                    r: Math.min(width, height) * 0.65,
                    colorStart: 'rgba(30, 64, 175, 0.75)', // #1E40AF Vibrant Royal Navy
                    colorEnd: 'rgba(6, 10, 23, 0)'
                },
                // Vivid Burnt Aerospace Orange / Terracotta Orb (Middle Right)
                {
                    x: width * 0.8 + Math.cos(time * 0.7) * 180,
                    y: (height * 0.5 - scrollShift * 0.8 + Math.sin(time * 0.9) * 130) % (height * 1.5),
                    r: Math.min(width, height) * 0.55,
                    colorStart: 'rgba(234, 88, 12, 0.68)', // #EA580C Burnt Orange
                    colorEnd: 'rgba(6, 10, 23, 0)'
                },
                // Deep Cobalt Indigo Orb (Middle Left)
                {
                    x: width * 0.35 + Math.sin(time * 1.1) * 200,
                    y: (height * 0.85 - scrollShift * 0.6 + Math.cos(time * 0.8) * 150) % (height * 1.5),
                    r: Math.min(width, height) * 0.6,
                    colorStart: 'rgba(30, 41, 59, 0.85)', // #1E293B Deep Slate Blue
                    colorEnd: 'rgba(6, 10, 23, 0)'
                },
                // Vibrant Rust-Copper Accent Node (Bottom Center)
                {
                    x: width * 0.65 + Math.cos(time * 0.6) * 150,
                    y: (height * 1.25 - scrollShift * 0.7 + Math.sin(time * 0.5) * 100) % (height * 1.5),
                    r: Math.min(width, height) * 0.5,
                    colorStart: 'rgba(194, 65, 12, 0.72)', // #C2410C Deep Rust
                    colorEnd: 'rgba(6, 10, 23, 0)'
                }
            ];

            blobs.forEach(b => {
                let posY = b.y;
                if (posY < -b.r) posY += height + b.r * 2;
                
                const grad = ctx.createRadialGradient(b.x, posY, 0, b.x, posY, b.r);
                grad.addColorStop(0, b.colorStart);
                grad.addColorStop(1, b.colorEnd);
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.arc(b.x, posY, b.r, 0, Math.PI * 2);
                ctx.fill();
            });

            // 3. Crisp Glowing Dynamic Wave Ribbons
            const waveLines = [
                { color: 'rgba(234, 88, 12, 0.18)', freq: 0.0014, amp: 85, shift: 0 + scrollProgress * 3, yOffset: 0.3 },
                { color: 'rgba(30, 64, 175, 0.22)', freq: 0.0018, amp: 110, shift: 1.8 + scrollProgress * 4, yOffset: 0.6 },
                { color: 'rgba(255, 255, 255, 0.08)', freq: 0.0011, amp: 70, shift: 3.5 + scrollProgress * 2.5, yOffset: 0.85 }
            ];

            waveLines.forEach(line => {
                ctx.beginPath();
                ctx.lineWidth = 2.0;
                ctx.strokeStyle = line.color;

                for (let x = 0; x <= width; x += 15) {
                    const y = Math.sin(x * line.freq + time + line.shift) * line.amp + (height * line.yOffset) + Math.cos(x * 0.0008 + time) * 40;
                    if (x === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();
            });

            requestAnimationFrame(animateBg);
        }

        window.onload = function() {
            animateBg();
        };

